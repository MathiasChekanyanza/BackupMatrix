# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backupmatrix
DB_USER=backupmatrix_user
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# API Key (shared for all shops)
MASTER_API_KEY=your_master_api_key_here_change_in_production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Data Retention (days)
RETENTION_DAYS=730

# PDF Generation
CHROME_PATH=

# Logging
LOG_LEVEL=info
LOG_FILE=logs/backupmatrix.log

# Frontend (when built)
SERVE_FRONTEND=true
FRONTEND_PATH=../frontend/dist
